[Unit]
Description=Amux headless worker client
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=amux
Group=amux
Environment=HOME=/var/lib/amux-client
StateDirectory=amux-client
ExecStart=/usr/local/bin/amux headless
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

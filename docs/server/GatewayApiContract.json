  "startup_invariants": [
    "Open explicit SQLite database, never source production file; PRAGMA journal_mode=WAL and foreign_keys=ON.",
    "Preserve db::apply_schema ordering including task_cancel::initialize, task_events::initialize, task_dispatch::initialize, artifact substrate schema, documentation retirement SQL, project casing validation and uniqueness indexes.",
    "Call task_events::recover once before accepting requests.",
    "Keep 30-second stale-task reclaimer that emits durable task_unclaimed events even with no board reads.",
    "Keep daily message retention policy with independent human/default and bot windows.",
    "Preserve configuration-dependent artifact operations envelope/body schema/auth behavior.",
    "Preserve original optional Discord/WhatsApp connector configuration, existing-room registration, plugin.start lifecycle, inbound processor and WhatsApp webhook wiring.",
    "Exclude only the standalone gateway updater/update polling and browser frontend; amux owns process update/lifecycle."
  ],
  "authentication_invariants": [
    "Keep configured GATEWAY_API_KEY Bearer parsing and status behavior for release one; no mTLS rewrite until release-two gate.",
    "Strip caller-supplied x-gateway-user and x-gateway-user-role before stamping verified identity.",
    "Bearer users are administrators; user/me and own-password routes require resolved session identity and must retain existing error behavior.",
    "API middleware also accepts verified gw_session for x-gateway-ui XHR. Retain backend HMAC/Argon2 helpers even when no browser routes are served.",
    "Do not set ui_auth_enabled=false merely because web frontend is omitted: original false setting permits arbitrary x-gateway-ui XHR to bypass bearer auth.",
    "Preserve separate provisioned task machine credentials and exact agent/session/generation header fences; API key alone does not replace machine authentication."
  ],
  "operational_interfaces": [
    "Local task-machine issue/revoke provisions and rotates credentials required by dispatch HTTP routes.",
    "Local task claim-info/recover uses optimistic concurrency token; needed for orphaned ownership recovery.",
    "Local user add/reset-password/list retains administration without browser UI."

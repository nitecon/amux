  "exclusion_rationale": {
    "browser_pages_login_logout_theme": "Existing native amux frontend remains; omit browser routes/UI templates. ui_auth backend cryptography and identity helpers remain for API compatibility.",
    "gateway_updater": "Do not port gateway executable updater or background external update polling; amux already owns updates.",
    "browser_only_queries": "TasksQuery references at routes.rs8234/8508 are in HTML handlers; no API handler requires ui rendering helpers.",
    "external_plugins_retained": "Owner explicitly approved keeping original external channel plugins/behavior for the first releases to enable repeated old-gateway/amux-server switching. Discord/WhatsApp connectors, room registration and inbound processing remain. Native internal channel adapter is deferred to task 01a17b97-b8c9-73e2-89c5-ae541ca0e814; it is not part of parity release."
  },
